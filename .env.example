ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__ChatbotDatabase=Server=localhost;Database=CairoChatbot;User Id=your_user;Password=your_password;TrustServerCertificate=True
Jwt__Issuer=CairoChatbot
Jwt__Audience=CairoChatbot.Api
Jwt__SigningKey=replace_with_at_least_32_random_characters
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Authentication__Lockout__MaximumFailedAttempts=5
Authentication__Lockout__LockoutMinutes=15
